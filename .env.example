APP_NAME="ЛИМС НГМК"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Tashkent
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ----------------------------------------------------------------------
# БАЗА ДАННЫХ
# ----------------------------------------------------------------------
# Для быстрого локального старта используется SQLite.
# Боевая база — Microsoft SQL Server: переключите DB_CONNECTION на sqlsrv
# и заполните параметры ниже (блок «SQL Server»).
DB_CONNECTION=sqlite

# --- SQL Server (боевой режим) -----------------------------------------
# DB_CONNECTION=sqlsrv
# DB_HOST=127.0.0.1
# DB_PORT=1433
# DB_DATABASE=lims_ngmk
# DB_USERNAME=sa
# DB_PASSWORD=YourStrong!Passw0rd
# Необязательно (если сервер требует):
# DB_ENCRYPT=yes
# DB_TRUST_SERVER_CERTIFICATE=true

# --- MySQL / MariaDB (альтернатива) ------------------------------------
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=lims_ngmk
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

VITE_APP_NAME="${APP_NAME}"
